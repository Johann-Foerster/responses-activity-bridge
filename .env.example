# Azure Bot / Entra app registration (Agents SDK)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# Responses API (Azure OpenAI v1 endpoint shown; any OpenAI-compatible /responses works)
RESPONSES_BASE_URL=https://<resource>.openai.azure.com/openai/v1
RESPONSES_API_KEY=
RESPONSES_MODEL=gpt-4.1
RESPONSES_INSTRUCTIONS=

# UI language when Teams sends no or an unsupported locale (de|en)
DEFAULT_LANGUAGE=de

HOST=0.0.0.0
PORT=3978

# Local testing only: accept unauthenticated requests (dev/fakes.py, Agents Playground). Never in production.
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=true
